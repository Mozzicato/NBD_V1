# Neon pooled PostgreSQL URL. Do not commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Neon direct (non-pooled) URL, used only by Prisma migration commands and Vercel builds.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"
APP_URL="http://localhost:3000"

# Commission in basis points (1000 = 10%), added on top of the poster's total.
COMMISSION_BPS=1000
# Hours after "Submitted" before escrow auto-releases to the worker (if no dispute).
AUTO_RELEASE_HOURS=72
# Comma-separated school email domains that verify without manual review.
SCHOOL_EMAIL_DOMAINS="live.unilag.edu.ng,unilag.edu.ng"

# Required in production. An empty value enables mock checkout in development only.
PAYSTACK_SECRET_KEY=""
# Protects /api/cron/auto-release
CRON_SECRET="dev-cron-secret"
# Required in production for email verification and magic links.
RESEND_API_KEY=""
EMAIL_FROM="No Broke Dayz <hello@nobrokedayz.com>"
# Create a private Vercel Blob store and add its read/write token.
BLOB_READ_WRITE_TOKEN=""
# Use a separate disposable Postgres database or Neon branch for this command:
# npm run test:escrow
TEST_DATABASE_URL=""
